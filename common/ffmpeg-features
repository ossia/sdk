# ffmpeg configure flags shared by every DESKTOP platform (linux, macos, mingw).
# Read by <platform>/ffmpeg.sh the same way common/qtfeatures is read by qt.sh:
#   ../ffmpeg-$FFMPEG_VERSION/configure $(ffmpeg_features linux) ...
# ffmpeg_features (common/ffmpeg-features.sh) concatenates this file with
# common/ffmpeg-features.<platform>, so a codec or protocol flag is changed in
# ONE place rather than in three ffmpeg.sh scripts.
#
# Unlike common/qtfeatures this file supports "#" comments and blank lines; the
# helper strips them. Nothing here may contain a shell variable or a space
# inside a single argument -- the result is word-split, exactly like qtfeatures.
# Anything that needs $CFLAGS / $INSTALL_PREFIX / --arch stays in ffmpeg.sh.
#
# WASM does NOT read this file: it shares almost none of it (no network, no
# external codecs, no hardware). See common/ffmpeg-features.wasm.

--enable-gpl
--enable-version3
--disable-doc
--disable-ffmpeg
--disable-ffplay
--disable-debug

# Never autodetect: it silently links whatever the build image happens to ship,
# which is how a "runs everywhere" binary picks up a dependency nobody asked
# for. Everything below is opted into explicitly.
--disable-autodetect

# ---------------------------------------------------------------- network ---
# Gives udp/udplite, tcp, rtp/srtp, rtsp, rtmp, http/hls and -- via each
# platform's TLS backend -- tls, dtls, https, rtmps and the whip muxer.
# NB: there is no WHEP demuxer in ffmpeg (checked 9.0 and master); WebRTC
# ingest is not available here.
--enable-network
--enable-protocols
--enable-libsrt

# ----------------------------------------------------------------- codecs ---
--enable-libdav1d
--enable-libx264
--enable-libx265
--enable-libopus
# VP8/VP9 software encoding. Without it the webm muxer has no usable software
# video encoder: ffmpeg decodes VP8/VP9 natively and dav1d covers AV1 decode,
# but the only encoders left would be av1_nvenc/av1_amf/av1_vulkan, i.e.
# hardware-only.
--enable-libvpx
--enable-libwebp
# JPEG XS. Needs ossia/SVT-JPEG-XS (see common/versions.sh): upstream cannot
# configure off x86.
--enable-libsvtjpegxs
# Hap DEcoding works without this (libavcodec carries its own snappy); Hap
# ENcoding needs the real library.
--enable-libsnappy
# ffmpeg has no native MP3 encoder, so without this MP3 export is impossible.
--enable-libmp3lame
# Gates the dash and imf demuxers -- DASH playback needs it.
--enable-libxml2

# ------------------------------------------------- compression and text ---
# Everything below is already built by the SDK itself and comes from it, never
# from the build image: zlib-ng (ZLIB_COMPAT), bzip2, xz and freetype+harfbuzz
# are core-stage builds in $INSTALL_PREFIX/sysroot on Linux and MSYS, and macOS
# takes zlib/bzip2 from the system SDK, where they are OS libraries present on
# every Mac.
#
# zlib is the load-bearing one, and leaving it to autodetection was how it got
# lost: png_decoder/png_encoder (and apng) select inflate_wrapper /
# deflate_wrapper, both gated on zlib, so WITHOUT IT FFMPEG HAS NO PNG CODEC AT
# ALL. Verified against the shipped SDK 36 Windows libavcodec.a, which has
# ff_png_decoder + an undefined `uncompress` because autodetect happened to pick
# zlib up there; Linux and macOS already passed --disable-autodetect and so had
# never had PNG. It also gives http/https its "Content-Encoding: gzip|deflate"
# handling (libavformat/http.c, CONFIG_ZLIB) -- which matters now that network
# is on -- plus EXR, deflate-compressed TIFF, flashsv/tscc/zmbv/rscc, the
# compressed matroska and mov header paths, and (via zlib_gzip) ffmpeg's own
# shader and resource compression.
--enable-zlib
# Matroska track headers may be bzip2-compressed.
--enable-bzlib
# drawtext. Both are required -- drawtext_filter_deps="libfreetype libharfbuzz"
# -- and both are core-stage builds already: Qt links the very same static
# archives, so this adds no new library to the SDK and no ODR risk.
# No libfontconfig: the SDK does not build it (Linux/fontconfig.sh is disabled),
# so drawtext takes fontfile= rather than font= by name.
--enable-libfreetype
--enable-libharfbuzz

--disable-iconv
--pkg-config-flags=--static
