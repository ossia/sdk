From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jean-Michael Celerier <jmcelerier@sat.qc.ca>
Date: Sun, 15 Nov 2026 12:11:53 -0500
Subject: [PATCH 2/2] rhi: maintain the buffer write serial on D3D11, D3D12 and
 Metal

Same call sites as in the Vulkan and OpenGL backends: create(), the
buffer operations of a resource update batch, the full dynamic buffer
update, and setShaderResources().
---
 src/gui/rhi/qrhid3d11.cpp | 5 +++++
 src/gui/rhi/qrhid3d12.cpp | 5 +++++
 src/gui/rhi/qrhimetal.mm  | 5 +++++
 3 files changed, 15 insertions(+)

diff --git a/src/gui/rhi/qrhid3d11.cpp b/src/gui/rhi/qrhid3d11.cpp
index 9db65370..afabe9b4 100644
--- a/src/gui/rhi/qrhid3d11.cpp
+++ b/src/gui/rhi/qrhid3d11.cpp
@@ -1052,6 +1052,7 @@ void QRhiD3D11::setShaderResources(QRhiCommandBuffer *cb, QRhiShaderResourceBind
     }
 
     QD3D11ShaderResourceBindings *srbD = QRHI_RES(QD3D11ShaderResourceBindings, srb);
+    storageBuffersWritten(srb);
 
     bool pipelineChanged = false;
     if (gfxPsD) {
@@ -1950,11 +1951,13 @@ void QRhiD3D11::enqueueResourceUpdates(QRhiCommandBuffer *cb, QRhiResourceUpdate
         const QRhiResourceUpdateBatchPrivate::BufferOp &u(ud->bufferOps[opIdx]);
         if (u.type == QRhiResourceUpdateBatchPrivate::BufferOp::DynamicUpdate) {
             QD3D11Buffer *bufD = QRHI_RES(QD3D11Buffer, u.buf);
+            bufferWritten(bufD);
             Q_ASSERT(bufD->m_type == QRhiBuffer::Dynamic);
             memcpy(bufD->dynBuf + u.offset, u.data.constData(), size_t(u.data.size()));
             bufD->hasPendingDynamicUpdates = true;
         } else if (u.type == QRhiResourceUpdateBatchPrivate::BufferOp::StaticUpload) {
             QD3D11Buffer *bufD = QRHI_RES(QD3D11Buffer, u.buf);
+            bufferWritten(bufD);
             Q_ASSERT(bufD->m_type != QRhiBuffer::Dynamic);
             Q_ASSERT(u.offset + u.data.size() <= bufD->m_size);
             QD3D11CommandBuffer::Command &cmd(cbD->commands.get());
@@ -3369,6 +3372,7 @@ bool QD3D11Buffer::create()
         buffer->SetPrivateData(WKPDID_D3DDebugObjectName, UINT(m_objectName.size()), m_objectName.constData());
 
     generation += 1;
+    QRhiImplementation::bufferWritten(this);
     rhiD->registerResource(this);
     return true;
 }
@@ -3391,6 +3395,7 @@ char *QD3D11Buffer::beginFullDynamicBufferUpdateForCurrentFrame()
     // fast path for dynamic buffers that have all their content changed in
     // every frame.
     Q_ASSERT(m_type == Dynamic);
+    QRhiImplementation::bufferWritten(this);
     D3D11_MAPPED_SUBRESOURCE mp;
     QRHI_RES_RHI(QRhiD3D11);
     HRESULT hr = rhiD->context->Map(buffer, 0, D3D11_MAP_WRITE_DISCARD, 0, &mp);
diff --git a/src/gui/rhi/qrhid3d12.cpp b/src/gui/rhi/qrhid3d12.cpp
index 318eb95a..ed62064f 100644
--- a/src/gui/rhi/qrhid3d12.cpp
+++ b/src/gui/rhi/qrhid3d12.cpp
@@ -1554,6 +1554,7 @@ void QRhiD3D12::setShaderResources(QRhiCommandBuffer *cb, QRhiShaderResourceBind
     }
 
     QD3D12ShaderResourceBindings *srbD = QRHI_RES(QD3D12ShaderResourceBindings, srb);
+    storageBuffersWritten(srb);
 
     bool pipelineChanged = false;
     if (gfxPsD) {
@@ -4483,6 +4484,7 @@ void QRhiD3D12::enqueueResourceUpdates(QD3D12CommandBuffer *cbD, QRhiResourceUpd
         const QRhiResourceUpdateBatchPrivate::BufferOp &u(ud->bufferOps[opIdx]);
         if (u.type == QRhiResourceUpdateBatchPrivate::BufferOp::DynamicUpdate) {
             QD3D12Buffer *bufD = QRHI_RES(QD3D12Buffer, u.buf);
+            bufferWritten(bufD);
             Q_ASSERT(bufD->m_type == QRhiBuffer::Dynamic);
             for (int i = 0; i < QD3D12_FRAMES_IN_FLIGHT; ++i) {
                 if (u.offset == 0 && u.data.size() == bufD->m_size)
@@ -4491,6 +4493,7 @@ void QRhiD3D12::enqueueResourceUpdates(QD3D12CommandBuffer *cbD, QRhiResourceUpd
             }
         } else if (u.type == QRhiResourceUpdateBatchPrivate::BufferOp::StaticUpload) {
             QD3D12Buffer *bufD = QRHI_RES(QD3D12Buffer, u.buf);
+            bufferWritten(bufD);
             Q_ASSERT(bufD->m_type != QRhiBuffer::Dynamic);
             Q_ASSERT(u.offset + u.data.size() <= bufD->m_size);
 
@@ -5215,6 +5218,7 @@ bool QD3D12Buffer::create()
     }
 
     generation += 1;
+    QRhiImplementation::bufferWritten(this);
     rhiD->registerResource(this);
     return true;
 }
@@ -5254,6 +5258,7 @@ char *QD3D12Buffer::beginFullDynamicBufferUpdateForCurrentFrame()
     Q_ASSERT(m_type == Dynamic);
     QRHI_RES_RHI(QRhiD3D12);
     Q_ASSERT(rhiD->inFrame);
+    QRhiImplementation::bufferWritten(this);
     if (QD3D12Resource *res = rhiD->resourcePool.lookupRef(handles[rhiD->currentFrameSlot]))
         return static_cast<char *>(res->cpuMapPtr);
 
diff --git a/src/gui/rhi/qrhimetal.mm b/src/gui/rhi/qrhimetal.mm
index 70355f74..2ef0a1ba 100644
--- a/src/gui/rhi/qrhimetal.mm
+++ b/src/gui/rhi/qrhimetal.mm
@@ -1701,6 +1701,7 @@ void QRhiMetal::setShaderResources(QRhiCommandBuffer *cb, QRhiShaderResourceBind
     }
 
     QMetalShaderResourceBindings *srbD = QRHI_RES(QMetalShaderResourceBindings, srb);
+    storageBuffersWritten(srb);
     bool hasSlottedResourceInSrb = false;
     bool hasDynamicOffsetInSrb = false;
     bool resNeedsRebind = false;
@@ -3434,6 +3435,7 @@ void QRhiMetal::enqueueResourceUpdates(QRhiCommandBuffer *cb, QRhiResourceUpdate
         const QRhiResourceUpdateBatchPrivate::BufferOp &u(ud->bufferOps[opIdx]);
         if (u.type == QRhiResourceUpdateBatchPrivate::BufferOp::DynamicUpdate) {
             QMetalBuffer *bufD = QRHI_RES(QMetalBuffer, u.buf);
+            bufferWritten(bufD);
             Q_ASSERT(bufD->m_type == QRhiBuffer::Dynamic);
             for (int i = 0; i < QMTL_FRAMES_IN_FLIGHT; ++i) {
                 if (u.offset == 0 && u.data.size() == bufD->m_size)
@@ -3444,6 +3446,7 @@ void QRhiMetal::enqueueResourceUpdates(QRhiCommandBuffer *cb, QRhiResourceUpdate
             // Due to the Metal API the handling of static and dynamic buffers is
             // basically the same. So go through the same pendingUpdates machinery.
             QMetalBuffer *bufD = QRHI_RES(QMetalBuffer, u.buf);
+            bufferWritten(bufD);
             Q_ASSERT(bufD->m_type != QRhiBuffer::Dynamic);
             Q_ASSERT(u.offset + u.data.size() <= bufD->m_size);
             for (int i = 0, ie = bufD->d->slotted ? QMTL_FRAMES_IN_FLIGHT : 1; i != ie; ++i)
@@ -4195,6 +4198,7 @@ bool QMetalBuffer::create()
 
     lastActiveFrameSlot = -1;
     generation += 1;
+    QRhiImplementation::bufferWritten(this);
     rhiD->registerResource(this);
     return true;
 }
@@ -4225,6 +4229,7 @@ char *QMetalBuffer::beginFullDynamicBufferUpdateForCurrentFrame()
     Q_ASSERT(m_type == Dynamic);
     QRHI_RES_RHI(QRhiMetal);
     Q_ASSERT(rhiD->inFrame);
+    QRhiImplementation::bufferWritten(this);
     const int slot = rhiD->currentFrameSlot;
     void *p = [d->buf[slot] contents];
     return static_cast<char *>(p);
-- 
