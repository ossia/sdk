diff --git a/src/gui/rhi/qrhi.cpp b/src/gui/rhi/qrhi.cpp
index ac07c210..265e806a 100644
--- a/src/gui/rhi/qrhi.cpp
+++ b/src/gui/rhi/qrhi.cpp
@@ -4286,6 +4286,91 @@ void QRhiBuffer::fullDynamicBufferUpdateForCurrentFrame(const void *data, quint3
     }
 }
 
+/*!
+    \fn quint64 QRhiBuffer::writeSerial() const
+
+    \return a value that changes every time an operation that defines or may
+    change the content of the buffer is recorded, or 0 when the backend does
+    not track buffer writes or create() has not been called yet.
+
+    This allows a consumer that mirrors or derives data from a buffer it does
+    not own (a copy, an acceleration structure, an accumulated image) to find
+    out if that work has to be redone: as long as the value is the same
+    non-zero value as before, nothing was recorded since then that could have
+    changed the content.
+
+    The serial changes when:
+
+    \list
+
+    \li create() succeeds. The content of a newly created buffer is undefined.
+
+    \li a QRhiResourceUpdateBatch containing
+    \l{QRhiResourceUpdateBatch::updateDynamicBuffer()}{updateDynamicBuffer()}
+    or \l{QRhiResourceUpdateBatch::uploadStaticBuffer()}{uploadStaticBuffer()}
+    operations for the buffer is committed, meaning it is passed to
+    \l{QRhiCommandBuffer::resourceUpdate()}{resourceUpdate()}, or to one of
+    the functions beginning or ending a pass. Queuing the operation on the
+    batch does not change the serial yet.
+
+    \li beginFullDynamicBufferUpdateForCurrentFrame() or
+    fullDynamicBufferUpdateForCurrentFrame() is called.
+
+    \li \l{QRhiCommandBuffer::setShaderResources()}{setShaderResources()} is
+    called in a render or compute pass with a QRhiShaderResourceBindings that
+    has the buffer in a
+    \l{QRhiShaderResourceBinding::BufferStore}{BufferStore} or
+    \l{QRhiShaderResourceBinding::BufferLoadStore}{BufferLoadStore} binding,
+    regardless of the shader stages of the binding and of what the shaders
+    then do with it. A \l{QRhiShaderResourceBinding::BufferLoad}{BufferLoad}
+    binding does not count as a write.
+
+    \li noteExternalWrite() is called.
+
+    \endlist
+
+    Using the buffer as vertex, index, indirect, or uniform buffer, and
+    \l{QRhiResourceUpdateBatch::readBackBuffer()}{reading it back}, do not
+    change the serial.
+
+    The values are unique within the process: two different buffers never
+    report the same non-zero value, and neither does the same QRhiBuffer
+    before and after a create(). Therefore comparing the serial alone is
+    sufficient, even when a buffer is destroyed and another one is later
+    allocated at the same address. For a given buffer the values only grow.
+
+    \note The serial follows the order in which operations are recorded on
+    the command buffer. This is the order in which the graphics API executes
+    them.
+
+    \note Writes that QRhi does not see are not tracked: native graphics API
+    calls made on the object returned from nativeBuffer(), typically between
+    \l{QRhiCommandBuffer::beginExternal()}{beginExternal()} and
+    \l{QRhiCommandBuffer::endExternal()}{endExternal()}, and writes made by a
+    shader to a buffer bound with BufferLoad access. Call noteExternalWrite()
+    to report the former.
+
+    \sa noteExternalWrite()
+ */
+
+/*!
+    Reports that the content of the buffer was, or is about to be, changed by
+    means QRhi has no knowledge of, such as a native copy command recorded
+    between \l{QRhiCommandBuffer::beginExternal()}{beginExternal()} and
+    \l{QRhiCommandBuffer::endExternal()}{endExternal()}. Gives the buffer a
+    new writeSerial().
+
+    Does nothing when the backend does not track buffer writes, or when
+    create() has not been called yet: writeSerial() stays 0 then.
+
+    \sa writeSerial()
+ */
+void QRhiBuffer::noteExternalWrite()
+{
+    if (m_writeSerial)
+        QRhiImplementation::bufferWritten(this);
+}
+
 /*!
     \class QRhiRenderBuffer
     \inmodule QtGuiPrivate
@@ -5885,12 +5970,56 @@ void QRhiImplementation::updateLayoutDesc(QRhiShaderResourceBindings *srb)
 {
     srb->m_layoutDescHash = 0;
     srb->m_layoutDesc.clear();
+    srb->m_hasStorageBufferWrites = false;
     auto layoutDescAppender = std::back_inserter(srb->m_layoutDesc);
     for (const QRhiShaderResourceBinding &b : std::as_const(srb->m_bindings)) {
         const QRhiShaderResourceBinding::Data *d = &b.d;
         srb->m_layoutDescHash ^= uint(d->binding) ^ uint(d->stage) ^ uint(d->type)
             ^ uint(d->arraySize());
         layoutDescAppender = d->serialize(layoutDescAppender);
+        if (d->type == QRhiShaderResourceBinding::BufferStore
+                || d->type == QRhiShaderResourceBinding::BufferLoadStore) {
+            srb->m_hasStorageBufferWrites = true;
+        }
+    }
+}
+
+/*!
+    \internal
+
+    Gives \a buf a new write serial. Called by the backends whenever they
+    record an operation that defines or may change the content of the buffer:
+    create(), a resource update, a full dynamic buffer update, and binding it
+    with store access.
+
+    The values come from one process-wide counter, so they are never repeated,
+    neither by another buffer nor by the same QRhiBuffer after create().
+ */
+void QRhiImplementation::bufferWritten(QRhiBuffer *buf)
+{
+    buf->m_writeSerial = QRhiGlobalObjectIdGenerator::newId();
+}
+
+/*!
+    \internal
+
+    Called by the backends from setShaderResources(): the storage buffers \a
+    srb binds with BufferStore or BufferLoadStore access are taken to be
+    written by the draw calls or dispatches that follow.
+
+    The binding types are part of the layout, so the flag computed in
+    updateLayoutDesc() stays valid across updateResources().
+ */
+void QRhiImplementation::storageBuffersWritten(QRhiShaderResourceBindings *srb)
+{
+    if (!srb->m_hasStorageBufferWrites)
+        return;
+    for (const QRhiShaderResourceBinding &b : std::as_const(srb->m_bindings)) {
+        const QRhiShaderResourceBinding::Data *d = &b.d;
+        if (d->type == QRhiShaderResourceBinding::BufferStore
+                || d->type == QRhiShaderResourceBinding::BufferLoadStore) {
+            bufferWritten(d->u.sbuf.buf);
+        }
     }
 }
 
