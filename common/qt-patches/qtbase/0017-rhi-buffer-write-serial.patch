+void tst_QRhi::bufferWriteSerial_data()
+{
+    rhiTestData();
+}
+
+void tst_QRhi::bufferWriteSerial()
+{
+    QFETCH(QRhi::Implementation, impl);
+    QFETCH(QRhiInitParams *, initParams);
+
+    QScopedPointer<QRhi> rhi(QRhi::create(impl, initParams, QRhi::Flags(), nullptr));
+    if (!rhi)
+        QSKIP("QRhi could not be created, skipping testing buffer write serials");
+
+    const int bufferSize = 64;
+    const QByteArray data(bufferSize, 'A');
+
+    QScopedPointer<QRhiBuffer> staticBuffer(rhi->newBuffer(QRhiBuffer::Static, QRhiBuffer::VertexBuffer, bufferSize));
+    // nothing is tracked before create()
+    QCOMPARE(staticBuffer->writeSerial(), quint64(0));
+    staticBuffer->noteExternalWrite();
+    QCOMPARE(staticBuffer->writeSerial(), quint64(0));
+
+    QVERIFY(staticBuffer->create());
+    const quint64 created = staticBuffer->writeSerial();
+    if (!created)
+        QSKIP("This backend does not track buffer writes");
+
+    QScopedPointer<QRhiBuffer> dynamicBuffer(rhi->newBuffer(QRhiBuffer::Dynamic, QRhiBuffer::UniformBuffer, bufferSize));
+    QVERIFY(dynamicBuffer->create());
+    const quint64 dynamicCreated = dynamicBuffer->writeSerial();
+    QVERIFY(dynamicCreated != 0);
+    // never the same value for two buffers
+    QVERIFY(dynamicCreated != created);
+
+    // queuing an update on a batch does not count, committing the batch does
+    QRhiResourceUpdateBatch *batch = rhi->nextResourceUpdateBatch();
+    QVERIFY(batch);
+    batch->uploadStaticBuffer(staticBuffer.data(), 0, bufferSize, data.constData());
+    batch->updateDynamicBuffer(dynamicBuffer.data(), 0, bufferSize, data.constData());
+    QCOMPARE(staticBuffer->writeSerial(), created);
+    QCOMPARE(dynamicBuffer->writeSerial(), dynamicCreated);
+    QVERIFY(submitResourceUpdates(rhi.data(), batch));
+    const quint64 uploaded = staticBuffer->writeSerial();
+    const quint64 dynamicUpdated = dynamicBuffer->writeSerial();
+    QVERIFY(uploaded > created);
+    QVERIFY(dynamicUpdated > dynamicCreated);
+    QVERIFY(uploaded != dynamicUpdated);
+
+    // a readback is not a write
+    {
+        batch = rhi->nextResourceUpdateBatch();
+        QVERIFY(batch);
+        QRhiReadbackResult readResult;
+        batch->readBackBuffer(dynamicBuffer.data(), 0, bufferSize, &readResult);
+        QRhiReadbackResult staticReadResult;
+        if (rhi->isFeatureSupported(QRhi::ReadBackNonUniformBuffer))
+            batch->readBackBuffer(staticBuffer.data(), 0, bufferSize, &staticReadResult);
+        QVERIFY(submitResourceUpdates(rhi.data(), batch));
+        QCOMPARE(dynamicBuffer->writeSerial(), dynamicUpdated);
+        QCOMPARE(staticBuffer->writeSerial(), uploaded);
+    }
+
+    // a full dynamic update is a write
+    {
+        QRhiCommandBuffer *cb = nullptr;
+        QCOMPARE(rhi->beginOffscreenFrame(&cb), QRhi::FrameOpSuccess);
+        dynamicBuffer->fullDynamicBufferUpdateForCurrentFrame(data.constData());
+        rhi->endOffscreenFrame();
+        QVERIFY(dynamicBuffer->writeSerial() > dynamicUpdated);
+    }
+
+    // writes done behind QRhi's back are reported by the application
+    staticBuffer->noteExternalWrite();
+    const quint64 noted = staticBuffer->writeSerial();
+    QVERIFY(noted > uploaded);
+
+    // a new native object: the content is undefined again
+    QVERIFY(staticBuffer->create());
+    QVERIFY(staticBuffer->writeSerial() > noted);
+
+    // storage buffers: a load binding reads, a load-store binding writes
+    if (impl == QRhi::Null || !rhi->isFeatureSupported(QRhi::Feature::Compute))
+        return;
+
+    QShader s = loadShader(":/data/storagebuffer.comp.qsb");
+    QVERIFY(s.isValid());
+    QMap<QByteArray, QShaderDescription::StorageBlock> blocks;
+    for (const QShaderDescription::StorageBlock &block : s.description().storageBlocks())
+        blocks[block.blockName] = block;
+
+    QRhiCommandBuffer *cb = nullptr;
+    rhi->beginOffscreenFrame(&cb);
+    QVERIFY(cb);
+    OffscreenFrameGuard frameGuard(rhi.data());
+
+    QScopedPointer<QRhiBuffer> toGpuBuffer(rhi->newBuffer(QRhiBuffer::Static, QRhiBuffer::StorageBuffer, blocks["toGpu"].knownSize));
+    QVERIFY(toGpuBuffer->create());
+    QScopedPointer<QRhiBuffer> fromGpuBuffer(rhi->newBuffer(QRhiBuffer::Static, QRhiBuffer::StorageBuffer, blocks["fromGpu"].knownSize));
+    QVERIFY(fromGpuBuffer->create());
+
+    QRhiResourceUpdateBatch *u = rhi->nextResourceUpdateBatch();
+    QVERIFY(u);
+    u->uploadStaticBuffer(toGpuBuffer.data(), QByteArray(blocks["toGpu"].knownSize, 0));
+    u->uploadStaticBuffer(fromGpuBuffer.data(), QByteArray(blocks["fromGpu"].knownSize, 0));
+
+    QScopedPointer<QRhiShaderResourceBindings> srb(rhi->newShaderResourceBindings());
+    srb->setBindings({QRhiShaderResourceBinding::bufferLoad(blocks["toGpu"].binding, QRhiShaderResourceBinding::ComputeStage, toGpuBuffer.data()),
+                      QRhiShaderResourceBinding::bufferLoadStore(blocks["fromGpu"].binding, QRhiShaderResourceBinding::ComputeStage, fromGpuBuffer.data())});
+    QVERIFY(srb->create());
+
+    QScopedPointer<QRhiComputePipeline> pipeline(rhi->newComputePipeline());
+    pipeline->setShaderStage({QRhiShaderStage::Compute, s});
+    pipeline->setShaderResourceBindings(srb.data());
+    QVERIFY(pipeline->create());
+
+    cb->beginComputePass(u);
+    const quint64 toGpuUploaded = toGpuBuffer->writeSerial();
+    const quint64 fromGpuUploaded = fromGpuBuffer->writeSerial();
+    cb->setComputePipeline(pipeline.data());
+    QCOMPARE(fromGpuBuffer->writeSerial(), fromGpuUploaded);
+    cb->setShaderResources();
+    cb->dispatch(1, 1, 1);
+    cb->endComputePass();
+    frameGuard.endFrame();
+
+    QCOMPARE(toGpuBuffer->writeSerial(), toGpuUploaded);
+    QVERIFY(fromGpuBuffer->writeSerial() > fromGpuUploaded);
+}
+
  void tst_QRhi::storageBufferRuntimeSizeCompute_data()
 {
      rhiTestData();
