+static inline VkPipelineStageFlags toVkPipelineStage(QRhiPassResourceTracker::BufferStages stages)
+{
+    VkPipelineStageFlags s = 0;
+    if (stages.testFlag(QRhiPassResourceTracker::BufIndirectDrawStage))
+        s |= VK_PIPELINE_STAGE_DRAW_INDIRECT_BIT;
+    if (stages.testFlag(QRhiPassResourceTracker::BufVertexInputStage))
+        s |= VK_PIPELINE_STAGE_VERTEX_INPUT_BIT;
+    if (stages.testFlag(QRhiPassResourceTracker::BufVertexStage))
+        s |= VK_PIPELINE_STAGE_VERTEX_SHADER_BIT;
+    if (stages.testFlag(QRhiPassResourceTracker::BufTCStage))
+        s |= VK_PIPELINE_STAGE_TESSELLATION_CONTROL_SHADER_BIT;
+    if (stages.testFlag(QRhiPassResourceTracker::BufTEStage))
+        s |= VK_PIPELINE_STAGE_TESSELLATION_EVALUATION_SHADER_BIT;
+    if (stages.testFlag(QRhiPassResourceTracker::BufFragmentStage))
+        s |= VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+    if (stages.testFlag(QRhiPassResourceTracker::BufComputeStage))
+        s |= VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+    if (stages.testFlag(QRhiPassResourceTracker::BufGeometryStage))
+        s |= VK_PIPELINE_STAGE_GEOMETRY_SHADER_BIT;
+
+    if (Q_UNLIKELY(!s))
         Q_UNREACHABLE();
-        break;
-    }
-    return 0;
+
+    return s;
 }
 
