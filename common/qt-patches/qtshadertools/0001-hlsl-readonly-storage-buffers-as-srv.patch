From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jean-Michael Celerier <jmcelerier@sat.qc.ca>
Date: Sun, 11 Oct 2026 11:06:43 -0400
Subject: [PATCH] shadertools: optionally emit readonly storage blocks as HLSL
 SRVs

Add QShaderBaker::setHlslReadOnlyStorageBuffersAsSrv(bool), off by
default; QT_SHADERTOOLS_HAS_HLSL_READONLY_SSBO_SRV advertises it.

When on, translateToHLSL lets SPIRV-Cross emit NonWritable (GLSL
readonly) storage blocks as ByteAddressBuffer instead of forcing every
block to RWByteAddressBuffer. They are placed in t registers after the
combined and separate images, and recorded as {tN, -2} in the native
resource binding map; -2 tells QRhiD3D11 (ossia SDK qtbase patch) to bind
a raw buffer SRV there. No other backend understands the marker, so only
enable this when baking for QRhi::D3D11.
---
 src/shadertools/qshaderbaker.cpp | 20 +++++++++++++++++++-
 src/shadertools/qshaderbaker.h   |  4 ++++
 src/shadertools/qspirvshader.cpp | 24 ++++++++++++++++++++++--
 src/shadertools/qspirvshader_p.h |  3 ++-
 4 files changed, 47 insertions(+), 4 deletions(-)

diff --git a/src/shadertools/qshaderbaker.cpp b/src/shadertools/qshaderbaker.cpp
index 2ffc2cb..4fd19b6 100644
--- a/src/shadertools/qshaderbaker.cpp
+++ b/src/shadertools/qshaderbaker.cpp
@@ -138,6 +138,7 @@ struct QShaderBakerPrivate
     int batchLoc = 7;
     bool perTargetEnabled = false;
     bool breakOnShaderTranslationError = true;
+    bool hlslReadOnlyStorageBuffersAsSrv = false;
     QSpirvShader::TessellationInfo tessInfo;
     QSpirvShader::MultiViewInfo multiViewInfo;
     QShaderBaker::SpirvOptions spirvOptions;
@@ -428,6 +429,22 @@ void QShaderBaker::setPerTargetCompilation(bool enable)
     d->perTargetEnabled = enable;
 }
 
+/*!
+    When \a enable is true, storage blocks declared \c readonly in GLSL are
+    emitted in HLSL as \c ByteAddressBuffer SRVs (t registers) instead of
+    \c RWByteAddressBuffer UAVs. Their native binding is reported as
+    {tN, -2}; only the D3D11 backend understands that marker, so enable
+    this only when baking for QRhi::D3D11. Default is false.
+
+    This lets Direct3D 11 read storage buffers in the vertex stage (UAVs are
+    pixel/compute-only there) and lets ps_5_0 use their contents in gradient
+    operations and cs_5_0 in barrier-controlling flow (X3662, X3663).
+ */
+void QShaderBaker::setHlslReadOnlyStorageBuffersAsSrv(bool enable)
+{
+    d->hlslReadOnlyStorageBuffersAsSrv = enable;
+}
+
 /*!
     Controls the behavior when shader translation (from SPIR-V to
     GLSL/HLSL/MSL) fails. By default this setting is true, which will cause
@@ -809,7 +826,8 @@ QShader QShaderBaker::bake()
             case QShader::HlslShader:
             {
                 QShader::NativeResourceBindingMap nativeBindings;
-                shader.setShader(currentSpirvShader->translateToHLSL(req.second.version(), &nativeBindings));
+                shader.setShader(currentSpirvShader->translateToHLSL(req.second.version(), &nativeBindings,
+                                                                     d->hlslReadOnlyStorageBuffersAsSrv));
                 if (shader.shader().isEmpty()) {
                     if (d->breakOnShaderTranslationError) {
                         d->errorMessage = currentSpirvShader->translationErrorMessage();
diff --git a/src/shadertools/qshaderbaker.h b/src/shadertools/qshaderbaker.h
index 1e75948..272732c 100644
--- a/src/shadertools/qshaderbaker.h
+++ b/src/shadertools/qshaderbaker.h
@@ -18,6 +18,8 @@
 #include <QtShaderTools/qtshadertoolsglobal.h>
 #include <rhi/qshader.h>
 
+#define QT_SHADERTOOLS_HAS_HLSL_READONLY_SSBO_SRV 1
+
 QT_BEGIN_NAMESPACE
 
 struct QShaderBakerPrivate;
@@ -57,6 +59,8 @@ public:
     void setBatchableVertexShaderExtraInputLocation(int location);
     void setPerTargetCompilation(bool enable);
     void setBreakOnShaderTranslationError(bool enable);
+    // ossia SDK patch; test with QT_SHADERTOOLS_HAS_HLSL_READONLY_SSBO_SRV
+    void setHlslReadOnlyStorageBuffersAsSrv(bool enable);
     void setTessellationMode(QShaderDescription::TessellationMode mode);
     void setTessellationOutputVertexCount(int count);
     void setMultiViewCount(int count);
diff --git a/src/shadertools/qspirvshader.cpp b/src/shadertools/qspirvshader.cpp
index cb49b05..6f0bf86 100644
--- a/src/shadertools/qspirvshader.cpp
+++ b/src/shadertools/qspirvshader.cpp
@@ -744,7 +744,8 @@ QByteArray QSpirvShader::translateToGLSL(int version,
     return result;
 }
 
-QByteArray QSpirvShader::translateToHLSL(int version, QShader::NativeResourceBindingMap *nativeBindings) const
+QByteArray QSpirvShader::translateToHLSL(int version, QShader::NativeResourceBindingMap *nativeBindings,
+                                         bool readOnlyStorageBuffersAsSrv) const
 {
     d->spirvCrossErrorMsg.clear();
 
@@ -761,8 +762,10 @@ QByteArray QSpirvShader::translateToHLSL(int version, QShader::NativeResourceBin
                                    true);
     spvc_compiler_options_set_bool(options, SPVC_COMPILER_OPTION_HLSL_POINT_COORD_COMPAT,
                                    true);
+    // With readOnlyStorageBuffersAsSrv, SPIRV-Cross emits NonWritable
+    // (GLSL readonly) storage blocks as ByteAddressBuffer (an SRV).
     spvc_compiler_options_set_bool(options, SPVC_COMPILER_OPTION_HLSL_FORCE_STORAGE_BUFFER_AS_UAV,
-                                   true);
+                                   !readOnlyStorageBuffersAsSrv);
     spvc_compiler_install_compiler_options(d->hlslGen, options);
 
     // D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT is 16, so we cannot have combined
@@ -808,6 +811,7 @@ QByteArray QSpirvShader::translateToHLSL(int version, QShader::NativeResourceBin
         nativeBindings->insert(var.binding, { regBinding, -1 });
         regBinding += var.arrayDims.isEmpty() ? 1 : var.arrayDims.first();
     }
+    const int firstStorageBufferSrvReg = regBinding; // next free t register
     regBinding = firstSeparateImageReg;
     const auto separateSamplers = d->shaderDescription.separateSamplers();
     for (const QShaderDescription::InOutVariable &var : separateSamplers) {
@@ -839,8 +843,24 @@ QByteArray QSpirvShader::translateToHLSL(int version, QShader::NativeResourceBin
     // UAV registers live in the same name space as outputs, so they must be bound
     // to at least outputVariables.size().
     regBinding = d->shaderDescription.outputVariables().size();
+    int srvReg = firstStorageBufferSrvReg;
     const auto storageBlocks = d->shaderDescription.storageBlocks();
     for (const QShaderDescription::StorageBlock &blk : storageBlocks) {
+        if (readOnlyStorageBuffersAsSrv
+            && blk.qualifierFlags.testFlag(QShaderDescription::QualifierReadOnly)) {
+            // ByteAddressBuffer in t<srvReg>. The -2 tells QRhiD3D11 to bind a
+            // raw buffer SRV instead of a UAV.
+            spvc_hlsl_resource_binding bindingMapping = {};
+            bindingMapping.stage = stage;
+            bindingMapping.desc_set = blk.descriptorSet;
+            bindingMapping.binding = blk.binding;
+            bindingMapping.srv.register_space = 0;
+            bindingMapping.srv.register_binding = srvReg;
+            spvc_compiler_hlsl_add_resource_binding(d->hlslGen, &bindingMapping);
+            nativeBindings->insert(blk.binding, { srvReg, -2 });
+            srvReg += 1;
+            continue;
+        }
         // readonly is also mapped to UAV due to FORCE_STORAGE_BUFFER_AS_UAV. (would be an SRV by default)
         spvc_hlsl_resource_binding bindingMapping = {};
         bindingMapping.stage = stage;
diff --git a/src/shadertools/qspirvshader_p.h b/src/shadertools/qspirvshader_p.h
index e6cb17e..5d63c2f 100644
--- a/src/shadertools/qspirvshader_p.h
+++ b/src/shadertools/qspirvshader_p.h
@@ -87,7 +87,8 @@ public:
                                const MultiViewInfo &multiViewInfo,
                                QVector<SeparateToCombinedImageSamplerMapping> *separateToCombinedImageSamplerMappings) const;
     QByteArray translateToHLSL(int version,
-                               QShader::NativeResourceBindingMap *nativeBindings) const;
+                               QShader::NativeResourceBindingMap *nativeBindings,
+                               bool readOnlyStorageBuffersAsSrv = false) const;
     QByteArray translateToMSL(int version,
                               MslFlags flags,
                               QShader::Stage stage,
-- 
